PORT=3000

# ---------------------------------------------- data store --
# sqlite   local file, zero setup, good for development
# supabase hosted Postgres, required in production
DB_DRIVER=sqlite

# Only for DB_DRIVER=supabase.
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://jvppierluckzhqkvifvc.supabase.co
# service_role key. Bypasses row-level security — server only,
# never send this to a browser, never commit it.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2cHBpZXJsdWNremhxa3ZpZnZjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjgyMDY1NSwiZXhwIjoyMDk4Mzk2NjU1fQ.bUys9zr7K0W9GBeRQG1qfv8GxqYctc69OoICbo1ovsU

# Only for DB_DRIVER=sqlite.
