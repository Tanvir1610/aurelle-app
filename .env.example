# ============================================================
# Aurelle — configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

PORT=3000

# ---------------------------------------------- data store --
# sqlite   local file, zero setup, good for development
# supabase hosted Postgres, required in production
DB_DRIVER=sqlite

# Only for DB_DRIVER=supabase.
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://jvppierluckzhqkvifvc.supabase.co
# service_role key. Bypasses row-level security — server only,
# never send this to a browser, never commit it.
SUPABASE_SERVICE_KEY=

# Only for DB_DRIVER=sqlite.
DATA_DIR=./data

# --------------------------------------------------- auth ---
# local  email + password stored in your own database
# clerk  Clerk hosted auth with email OTP
AUTH_DRIVER=clerk

# Clerk dashboard -> API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_Y3JlZGlibGUtYmxvd2Zpc2gtMzQuY2xlcmsuYWNjb3VudHMuZGV2JA
# Secret key. Server only. Rotate immediately if it ever leaks.
CLERK_SECRET_KEY=

# First dashboard administrator. On boot this email is added to
# the admin list; whoever signs in with it via Clerk gets access.
ADMIN_EMAIL=vhoratanvir1610@gmail.com

# Only used when AUTH_DRIVER=local.
ADMIN_PASSWORD=aurelle-admin
SESSION_SECRET=

# ------------------------------------------------- extras ---
# Refill demo data on boot (ephemeral hosts).
SEED_DEMO=0

# ------------------------------------------------ payments ---
# Cashfree dashboard -> Developers -> API Keys.
# CASHFREE_ENV defaults to sandbox; production is deliberately opt-in so a
# misconfigured deploy cannot take real money by accident.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Where shoppers return to after paying, and where the webhook is delivered.
PUBLIC_URL=https://aurelle-app.onrender.com

# --------------------------------------------------- email ---
# Gmail: create an App Password (Google Account -> Security -> App passwords).
# Never the account password, and never committed to the repository.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
STORE_NAME=Aurelle

# ----------------------------------------------- sms login ---
# DLT registration for transactional SMS in India. Register your own
# sender ID and template — see SMS-LOGIN.md.
SMS_API_KEY=
SMS_SENDER=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=
SMS_TEMPLATE=Dear User, Your Login OTP {otp} Valid for {mins} Please do not share this OTP.
OTP_TTL_MINUTES=10
